# Copie ce fichier en .env (ignoré par git, chmod 600) ; l'entretien d'installation le fait pour toi.
# Une variable déjà définie dans l'environnement passe devant celle du fichier.

# --- Claude : API ou abonnement ---
# api (par défaut) : clé ANTHROPIC_API_KEY, crédit prépayé, facturé à l'usage.
# abonnement : passe par Claude Code et ton abonnement Claude (Pro, Max), sans clé API.
#   Rien à payer en plus, mais chaque jugement entame ton quota Claude (environ 3 fois plus
#   de jetons qu'en API) et prend 30 à 45 s au lieu de 10 à 15.
NEST_CLAUDE=api
# Mode api : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Mode abonnement : jeton longue durée donné par `claude setup-token` (indispensable pour
# la tâche planifiée, la connexion normale de Claude Code expire).
CLAUDE_CODE_OAUTH_TOKEN=
# Mode abonnement, seulement si nest ne trouve pas Claude Code : son chemin (`which claude`).
NEST_CLAUDE_BIN=

# --- Indispensables ---
# Google Cloud, API « Routes » activée (sans elle : trajets estimés à vol d'oiseau)
GOOGLE_MAPS_API_KEY=
# Nom de canal ntfy aléatoire et secret, ex. nest-7f3a9c2e41d8
NTFY_TOPIC=
NTFY_SERVEUR=https://ntfy.sh

# --- Facultatif : Gens de Confiance ---
# Cookie de ta session connectée, entre guillemets ; vide = source ignorée
GDC_COOKIE=

# --- Facultatif : tri des mails d'agence (Gmail en lecture seule, voir nest/mails/gmail.py) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Facultatif : miroir Notion du suivi des candidatures (voir nest/notion.py) ---
NOTION_TOKEN=
NOTION_BASE_SUIVI=
