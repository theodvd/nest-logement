# Copie ce fichier en .env (ignoré par git, chmod 600) ; l'entretien d'installation le fait pour toi.
# Une variable déjà définie dans l'environnement passe devant celle du fichier.

# --- Indispensables ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google Cloud, API « Routes » activée (sans elle : trajets estimés à vol d'oiseau)
GOOGLE_MAPS_API_KEY=
# Nom de canal ntfy aléatoire et secret, ex. nest-7f3a9c2e41d8
NTFY_TOPIC=
NTFY_SERVEUR=https://ntfy.sh

# --- Facultatif : Gens de Confiance ---
# Cookie de ta session connectée, entre guillemets ; vide = source ignorée
GDC_COOKIE=

# --- Facultatif : tri des mails d'agence (Gmail en lecture seule, voir nest/mails/gmail.py) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Facultatif : miroir Notion du suivi des candidatures (voir nest/notion.py) ---
NOTION_TOKEN=
NOTION_BASE_SUIVI=
